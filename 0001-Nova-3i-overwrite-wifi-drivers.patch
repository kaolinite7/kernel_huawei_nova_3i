+        oal_print_hi11xx_log(HI11XX_LOG_INFO, "hisi wifi bus pcie switch disable");
+        return oal_load_dev();
+    } else {
+        oal_print_hi11xx_log(HI11XX_LOG_INFO, "hisi wifi bus pcie switch enable");
+        return oal_load_dev_retry();
+    }
 }
 
